rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny: Zero-Trust Security Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Private single-user Hunter System state
    // Strictly isolates all progression, quests, skills, and ledger to the authenticated user
    match /users/{userId}/system/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidId(docId)
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidId(docId)
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
    }
  }
}
